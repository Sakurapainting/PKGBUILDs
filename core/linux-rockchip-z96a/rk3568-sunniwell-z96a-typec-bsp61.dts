/dts-v1/;

#include "rk3568-sunniwell-z96a-typec-board.dtsi"

/* Keep the VPLL output mux in the mode selected by the bootloader. */
&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	/delete-property/ assigned-clock-rates;
};

/*
 * Match the working factory handoff even if U-Boot cannot load a resource
 * partition (e.g. the full LBA0 image). In that case the BSP's defaults
 * otherwise put Smart1 on eDP's VP1 and the Niri session can scan out black.
 */
&vp0 {
	rockchip,plane-mask = <0x2a>; /* Cluster1, Esmart1, Smart1 */
	rockchip,primary-plane = <5>; /* Smart1 */
};

&vp1 {
	rockchip,plane-mask = <0x15>; /* Cluster0, Esmart0, Smart0 */
	rockchip,primary-plane = <4>; /* Smart0 */
};

/* Keep the independent NPU bus voltage scaler off as in the hardware trial. */
&bus_npu {
	status = "disabled";
};

/* The raw-disk image's U-Boot may leave DCDC4 at 500 mV. */
&vdd_npu {
	regulator-min-microvolt = <850000>;
};

/* Ensure DCDC4 is configured before the NPU IOMMU attaches to genpd. */
&power {
	npu-supply = <&vdd_npu>;
};

/* Cap both the initial frequency and available OPPs at the standard 600 MHz. */
&npu_opp_table {
	rockchip,init-freq = <600000>;
	/delete-node/ opp-700000000;
	/delete-node/ opp-800000000;
	/delete-node/ opp-900000000;
	/delete-node/ opp-1000000000;
	/delete-node/ opp-m-900000000;

	opp-600000000 {
		opp-microvolt = <875000 875000 1000000>;
	};
};

&npu_opp_j_od_800000000 {
	status = "disabled";
};

&rknpu {
	rknpu-supply = <&vdd_npu>;
	status = "okay";
};

&rknpu_mmu {
	status = "okay";
};

/ {
	backlight: backlight {
		compatible = "pwm-backlight";
		brightness-levels = <20 220>;
		default-brightness-level = <200>;
		enable-gpios = <&gpio2 RK_PD5 GPIO_ACTIVE_HIGH>;
		num-interpolated-steps = <200>;
		power-supply = <&vcc3v3_sys>;
		pwms = <&pwm9 0 25000 0>;
	};

	leds {
		compatible = "gpio-leds";

		led-power {
			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
			default-state = "on";
			function = "power";
		};
	};

	battery_thermistor: battery-thermistor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&saradc 4>;
		io-channel-names = "sensor-channel";
		/* Jun Yan's Z96A curve: 10 kOhm NTC, 10 kOhm pull-up to 1.8 V. */
		temperature-lookup-table = <
			(-20000) 1629	(-19000) 1621	(-18000) 1612	(-17000) 1603
			(-16000) 1592	(-15000) 1580	(-14000) 1570	(-13000) 1560
			(-12000) 1548	(-11000) 1535	(-10000) 1521	(-9000) 1510
			(-8000) 1497	(-7000) 1484	(-6000) 1469	(-5000) 1453
			(-4000) 1439	(-3000) 1425	(-2000) 1410	(-1000) 1393
			0 1375		1000 1360	2000 1344	3000 1327
			4000 1308	5000 1289	6000 1272	7000 1255
			8000 1237	9000 1217	10000 1196	11000 1178
			12000 1160	13000 1141	14000 1120	15000 1098
			16000 1080	17000 1062	18000 1042	19000 1021
			20000 999	21000 981	22000 962	23000 942
			24000 921	25000 900	26000 882	27000 864
			28000 845	29000 825	30000 804	31000 787
			32000 769	33000 751	34000 732	35000 713
			36000 697	37000 680	38000 663	39000 646
			40000 628	41000 613	42000 598	43000 582
			44000 566	45000 550	46000 537	47000 523
			48000 509	49000 495	50000 480	51000 468
			52000 456	53000 443	54000 430	55000 417
			56000 407	57000 396	58000 385	59000 374
			60000 362
		>;
	};

	pdm-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "es7202-mic";
		simple-audio-card,format = "pdm";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&pdm>;
		};
		simple-audio-card,codec {
			sound-dai = <&es7202_mic>;
		};
	};
};

&thermal_zones {
	battery-thermal {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&battery_thermistor>;
	};
};

/* BSP RK817 selects the playback path through mixer controls. */
&rk809_sound {
	/delete-property/ simple-audio-card,aux-devs;
	/delete-property/ simple-audio-card,routing;
	/delete-property/ simple-audio-card,widgets;
	/delete-property/ simple-audio-card,pin-switches;

	simple-audio-card,codec {
		sound-dai = <&rk809_codec>;
	};
};

&spk_amp {
	status = "disabled";
};

&rk809 {
	rk809_codec: codec {
		compatible = "rockchip,rk809-codec", "rockchip,rk817-codec";
		#sound-dai-cells = <0>;
		clocks = <&cru I2S1_MCLKOUT_TX>;
		clock-names = "mclk";
		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_en>;
		hp-volume = <0x14>;
		spk-volume = <0x03>;
		mic-in-differential;
		use-ext-amplifier;
		spk-ctl-gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
	};
};

&i2c3 {
	es7202_mic: codec@30 {
		/* Compatible used by the BSP ES7202 driver and the factory DT. */
		compatible = "ES7202_PDM_ADC_1";
		reg = <0x30>;
		#sound-dai-cells = <0>;
	};
};

&i2c0 {
	charger@6b {
		compatible = "sunniwell,z96a-sc8886s-monitor";
		reg = <0x6b>;
	};
};

&pdm {
	pinctrl-0 = <&pdmm0_clk1 &pdmm0_sdi1>;
	/* The internal microphone ADC is on SDI1. */
	rockchip,path-map = <1 3 0 2>;
	status = "okay";
};

&edp_phy {
	status = "okay";
};

&edp {
	force-hpd;
	status = "okay";

	ports {
		port@1 {
			reg = <1>;

			edp_out_panel: endpoint {
				remote-endpoint = <&panel_in_edp>;
			};
		};
	};

	aux-bus {
		panel {
			compatible = "edp-panel";
			backlight = <&backlight>;
			power-supply = <&vcc3v3_lcd0_n>;
			no-hpd;

			port {
				panel_in_edp: endpoint {
					remote-endpoint = <&edp_out_panel>;
				};
			};
		};
	};
};

&edp_in_vp1 {
	status = "okay";
};

&rtl8822cs {
	realtek,disable-lps-deep;
};

/* Keep VOP DMA translation and skip the failing MMU reset command. */
&vop_mmu {
	rockchip,disable-mmu-reset;
};

/* Panfrost uses the standard GPU clock and interrupt names. */
&gpu {
	operating-points-v2 = <&z96a_gpu_opp_table>;
	compatible = "rockchip,rk3568-mali", "arm,mali-bifrost";
	interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "job", "mmu", "gpu";
	clock-names = "gpu", "bus";
};

/* Use the Z96A mainline GPU OPPs through 600 MHz. */
/ {
	z96a_gpu_opp_table: opp-table-gpu-z96a {
		compatible = "operating-points-v2";

		opp-200000000 {
			opp-hz = /bits/ 64 <200000000>;
			opp-microvolt = <850000 850000 1000000>;
		};

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <850000 850000 1000000>;
		};

		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <850000 850000 1000000>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <900000 900000 1000000>;
		};
	};
};
